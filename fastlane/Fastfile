default_platform(:ios)

platform :ios do
  desc "Build and upload imart to App Store Connect"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_PRIVATE_KEY_B64"],
      is_key_content_base64: true,
      in_house: false
    )

    login_keychain = File.expand_path("~/Library/Keychains/login.keychain-db")

    # In case certificate limit was reached from prior runs, auto-heal
    begin
      get_certificates(
        api_key: api_key,
        development: false,
        keychain_path: login_keychain,
        keychain_password: ""
      )
    rescue => ex
      if ex.message.include?("maximum number of available Distribution certificates")
        UI.important("Certificate limit reached. Cleaning up older certificates...")
        certs = Spaceship::ConnectAPI::Certificate.all(filter: { certificateType: "DISTRIBUTION" })
        certs.each { |c| c.delete! }
        get_certificates(
          api_key: api_key,
          development: false,
          force: true,
          keychain_path: login_keychain,
          keychain_password: ""
        )
      else
        raise ex
      end
    end

    # Fetch or create App Store Provisioning Profile
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "app.web.imart.business",
      force: true
    )

    # Set code signing to manual using downloaded profile
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "imart.xcodeproj",
      team_id: "Q6M87N5K22",
      bundle_identifier: "app.web.imart.business",
      profile_name: lane_context[SharedValues::SIGH_NAME],
      code_sign_identity: "Apple Distribution"
    )

    # Build the archive and package IPA
    build_app(
      workspace: "imart.xcworkspace",
      scheme: "imart",
      export_method: "app-store",
      output_directory: "build/ipa",
      output_name: "imart.ipa"
    )

    # Upload to App Store Connect
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
