default_platform(:ios)

platform :ios do
  desc "Build and upload imart to App Store Connect"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_PRIVATE_KEY"],
      is_key_content_base64: false,
      in_house: false
    )

    # Create temporary keychain for CI runner
    create_keychain(
      name: "ci_keychain",
      password: "ci_password",
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    # Fetch or generate App Store Distribution Certificate
    get_certificates(
      api_key: api_key,
      development: false,
      keychain_path: "~/Library/Keychains/ci_keychain-db"
    )

    # Fetch or generate App Store Provisioning Profile
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "app.web.imart.business"
    )

    # Build the iOS Archive and IPA
    build_app(
      workspace: "imart.xcworkspace",
      scheme: "imart",
      export_method: "app-store",
      output_directory: "build/ipa",
      output_name: "imart.ipa"
    )

    # Upload IPA to App Store Connect / TestFlight
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
