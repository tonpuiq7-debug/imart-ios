default_platform(:ios)

platform :ios do
  desc "Build and upload imart to App Store Connect"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_PRIVATE_KEY_B64"],
      is_key_content_base64: true,
      in_house: false
    )

    keychain_name = "ci_keychain"
    keychain_password = "ci_password"

    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    get_certificates(
      api_key: api_key,
      development: false
    )

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "app.web.imart.business"
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "imart.xcodeproj",
      team_id: "Q6M87N5K22",
      bundle_identifier: "app.web.imart.business",
      profile_name: lane_context[SharedValues::SIGH_NAME],
      code_sign_identity: "Apple Distribution"
    )

    build_app(
      workspace: "imart.xcworkspace",
      scheme: "imart",
      export_method: "app-store",
      output_directory: "build/ipa",
      output_name: "imart.ipa"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
