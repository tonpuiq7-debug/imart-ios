default_platform(:ios)

platform :ios do
  desc "Build and upload imart to App Store Connect"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_PRIVATE_KEY_B64"],
      is_key_content_base64: true,
      in_house: false
    )

    keychain_path = File.expand_path("~/Library/Keychains/build.keychain-db")
    keychain_pwd = "build_pwd"

    # Fetch existing or create new Distribution Certificate in dedicated keychain
    get_certificates(
      api_key: api_key,
      development: false,
      keychain_path: keychain_path,
      keychain_password: keychain_pwd
    )

    # Allow codesign to access the private key non-interactively
    sh("security", "set-key-partition-list", "-S", "apple-tool:,apple:,codesign:", "-s", "-k", keychain_pwd, keychain_path)

    # Fetch or create App Store Provisioning Profile
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "app.web.imart.business"
    )

    # Set code signing to manual using downloaded profile
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "imart.xcodeproj",
      team_id: "Q6M87N5K22",
      bundle_identifier: "app.web.imart.business",
      profile_name: lane_context[SharedValues::SIGH_NAME],
      code_sign_identity: "Apple Distribution"
    )

    # Build the archive and package IPA
    build_app(
      workspace: "imart.xcworkspace",
      scheme: "imart",
      export_method: "app-store",
      output_directory: "build/ipa",
      output_name: "imart.ipa"
    )

    # Upload to App Store Connect
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
